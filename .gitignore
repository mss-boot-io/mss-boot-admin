# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage*

# Dependency directories are generated on demand.
vendor/
**/node_modules/

# IDE
.vscode/
.idea/

# Local configuration and databases
config/application-*
*.db

# Runtime and build output
temp/
test/
public/
dist/
**/dist/
mss-boot-admin
mss-boot-admin.exe
compose/**/**/datalogs/
logs/

# Frontend test output
web/antd/test-results/
web/antd/playwright-report/

# Local agent-native reports, process state, logs, caches, and generated app output
.mss/reports/
.mss/run/
.mss/logs/
.mss/cache/
.mss/output/
