# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage*
.coverage/

# Dependency directories are generated on demand.
vendor/
**/node_modules/
__pycache__/
*.py[cod]

# IDE
.vscode/
.idea/

# Local configuration and databases
config/application-*
admin/config/application-*
!admin/config/application-e2e.yml
!admin/config/application-local.yml
*.db

# Runtime and build output
bin/
!web/antd-v6/bin/
!web/antd-v6/bin/mss-admin-web.cjs
temp/
test/
public/
!web/antd-v6/public/
!web/antd-v6/public/**
admin/public/
dist/
**/dist/
mss-boot-admin
mss-boot-admin.exe
compose/**/**/datalogs/
logs/

# Frontend test output
web/antd-v6/test-results/
web/antd-v6/playwright-report/

# Local agent-native reports, process state, logs, caches, and generated app output
.mss/reports/
.mss/run/
.mss/logs/
.mss/cache/
.mss/output/

# LiteLLM Ops release staging and local recovery artifacts. Keep only the
# container recipes below; binaries, frontend bundles, logs, and database
# copies must never enter Git.
/deploy/litellm-ops/build/backend/*
!/deploy/litellm-ops/build/backend/Dockerfile
/deploy/litellm-ops/build/web/*
!/deploy/litellm-ops/build/web/Dockerfile
!/deploy/litellm-ops/build/web/nginx.conf
/deploy/litellm-ops/rendered/
/deploy/litellm-ops/backups/
/deploy/litellm-ops/**/*.db
/deploy/litellm-ops/**/*.db-wal
/deploy/litellm-ops/**/*.db-shm
/deploy/litellm-ops/**/mss-boot-admin
