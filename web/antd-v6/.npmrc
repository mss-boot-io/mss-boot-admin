# Umi Max 4.7.5 still declares React 16/18 and antd 4 peers while the official
# Pro v6 application runs React 19 and antd 6. The exact transition graph is
# enforced by scripts/check-dependencies.mjs instead of an unscoped peer bypass.
strict-peer-dependencies=false
auto-install-peers=true
save-exact=true
resolution-mode=highest
