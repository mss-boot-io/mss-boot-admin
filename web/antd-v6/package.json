{
  "name": "@mss-boot-io/admin-web",
  "version": "1.3.0-development",
  "description": "Complete React 19 and Ant Design 6 Admin application for mss-boot business hosts.",
  "packageManager": "pnpm@10.34.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mss-boot-io/mss-boot-admin.git",
    "directory": "web/antd-v6"
  },
  "homepage": "https://docs.mss-boot-io.top/",
  "bugs": {
    "url": "https://github.com/mss-boot-io/mss-boot-admin/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "mssAdminDistribution": {
    "packageManager": "pnpm@10.34.5",
    "dependencyClasses": {
      "runtime": [
        "@ant-design/icons",
        "@ant-design/pro-components",
        "@tanstack/react-query",
        "antd",
        "antd-style",
        "clsx",
        "d",
        "dayjs",
        "react",
        "react-dom"
      ],
      "tooling": [
        "@biomejs/biome",
        "@tailwindcss/postcss",
        "@types/node",
        "@types/react",
        "@types/react-dom",
        "@umijs/max",
        "happy-dom",
        "less",
        "tailwindcss",
        "typescript",
        "vite",
        "vitest"
      ]
    },
    "buildOnlyDependencies": {
      "image-size": [
        "0.5.5"
      ],
      "immer": [
        "8.0.4"
      ],
      "node-fetch": [
        "1.7.3"
      ],
      "path-to-regexp": [
        "1.7.0"
      ],
      "vite": [
        "4.5.2"
      ]
    },
    "runtimeOverrides": {
      "@ant-design/pro-components": "3.1.14-6",
      "@tanstack/react-query": "5.101.4",
      "antd": "6.6.0",
      "axios": "0.33.0",
      "react": "19.2.8",
      "react-dom": "19.2.8"
    }
  },
  "files": [
    "bin",
    "package",
    "public",
    "scripts/check-bundle-budget.mjs",
    "scripts/check-dependencies.mjs",
    "scripts/check-release-api.mjs",
    "scripts/check-runtime-bundle.mjs",
    "src",
    "tests/setup.ts",
    "biome.json",
    "postcss.config.cjs",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./package/runtime.ts",
      "import": "./package/runtime.ts",
      "default": "./package/runtime.ts"
    },
    "./business": {
      "types": "./package/business.d.ts",
      "require": "./package/business.cjs",
      "default": "./package/business.cjs"
    },
    "./preset": {
      "types": "./package/mssAdminPreset.d.ts",
      "require": "./package/mssAdminPreset.cjs",
      "default": "./package/mssAdminPreset.cjs"
    },
    "./runtime": {
      "types": "./package/runtime.ts",
      "import": "./package/runtime.ts",
      "default": "./package/runtime.ts"
    },
    "./runtime/access": {
      "types": "./src/access.ts",
      "import": "./src/access.ts",
      "default": "./src/access.ts"
    },
    "./runtime/app": {
      "types": "./src/app.tsx",
      "import": "./src/app.tsx",
      "default": "./src/app.tsx"
    },
    "./runtime/locales/en-US": {
      "types": "./package/locales/en-US.ts",
      "import": "./package/locales/en-US.ts",
      "default": "./package/locales/en-US.ts"
    },
    "./runtime/locales/zh-CN": {
      "types": "./package/locales/zh-CN.ts",
      "import": "./package/locales/zh-CN.ts",
      "default": "./package/locales/zh-CN.ts"
    },
    "./styles": {
      "import": "./src/global.tsx",
      "default": "./src/global.tsx"
    },
    "./testing": {
      "types": "./package/testing.ts",
      "import": "./package/testing.ts",
      "default": "./package/testing.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mss-admin-web": "./bin/mss-admin-web.cjs"
  },
  "sideEffects": [
    "**/*.css",
    "./src/global.tsx"
  ],
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "audit:release": "node ../../tools/security/check-pnpm-audit.mjs",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "build": "max build",
    "build:local": "cross-env REACT_APP_ENV=local UMI_ENV=local max build",
    "build:release": "cross-env REACT_APP_ENV=release UMI_ENV=release max build && python3 ../../tools/release/prepare_portable_frontend.py dist && node scripts/check-runtime-bundle.mjs && node scripts/check-bundle-budget.mjs && node scripts/check-release-api.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "delivery:smoke": "bash scripts/smoke-nginx-delivery.sh",
    "deps:check": "node scripts/check-dependencies.mjs",
    "dev": "cross-env PORT=8001 REACT_APP_ENV=dev UMI_ENV=dev MOCK=none max dev",
    "lint": "biome check . && max setup && tsc --noEmit",
    "playwright:install": "playwright install chromium",
    "preview": "cross-env REACT_APP_ENV=local UMI_ENV=local max build && max preview --port 8001",
    "release:check": "node scripts/check-release-api.mjs",
    "runtime:check": "node scripts/check-runtime-bundle.mjs",
    "setup": "max setup",
    "start": "cross-env PORT=8001 UMI_ENV=dev MOCK=none max dev",
    "start:dev": "cross-env PORT=8001 REACT_APP_ENV=dev UMI_ENV=dev MOCK=none max dev",
    "start:e2e": "cross-env MSS_V6_E2E=1 PORT=18001 REACT_APP_ENV=dev UMI_ENV=dev MOCK=none max dev",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default",
    "test:e2e": "playwright test",
    "test:e2e:parity": "playwright test --grep @parity",
    "test:e2e:permission": "playwright test --grep @permission",
    "test:e2e:settings": "playwright test --grep @settings",
    "test:e2e:debug": "playwright test --debug",
    "test:update": "vitest run -u",
    "tsc": "max setup && tsc --noEmit"
  },
  "browserslist": [
    "Chrome >= 120",
    "Edge >= 120",
    "Firefox >= 121",
    "Safari >= 17.4"
  ],
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/pro-components": "3.1.14-6",
    "@biomejs/biome": "2.5.8",
    "@tanstack/react-query": "5.101.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@umijs/max": "4.7.5",
    "antd": "6.6.0",
    "antd-style": "4.1.0",
    "clsx": "2.1.1",
    "d": "1.0.2",
    "dayjs": "1.11.21",
    "happy-dom": "20.11.2",
    "less": "4.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "cross-env": "10.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.34.5"
  },
  "pnpm": {
    "overrides": {
      "@ant-design/pro-components": "3.1.14-6",
      "@tanstack/react-query": "5.101.4",
      "antd": "6.6.0",
      "axios": "0.33.0",
      "react": "19.2.8",
      "react-dom": "19.2.8"
    }
  }
}
