{
  "name": "mss-boot-admin-antd-v6",
  "version": "0.0.0-development",
  "private": true,
  "description": "Independent React 19 and Ant Design 6.6.0 management application for mss-boot.",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "build": "max build",
    "build:local": "cross-env REACT_APP_ENV=local UMI_ENV=local max build",
    "build:release": "cross-env REACT_APP_ENV=release UMI_ENV=release max build && node scripts/check-runtime-bundle.mjs && node scripts/check-bundle-budget.mjs && node scripts/check-release-api.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "delivery:smoke": "bash scripts/smoke-nginx-delivery.sh",
    "deps:check": "node scripts/check-dependencies.mjs",
    "dev": "cross-env PORT=8001 REACT_APP_ENV=dev UMI_ENV=dev MOCK=none max dev",
    "lint": "biome check . && max setup && tsc --noEmit",
    "playwright:install": "playwright install chromium",
    "preview": "cross-env REACT_APP_ENV=local UMI_ENV=local max build && max preview --port 8001",
    "release:check": "node scripts/check-release-api.mjs",
    "runtime:check": "node scripts/check-runtime-bundle.mjs",
    "setup": "max setup",
    "start": "cross-env PORT=8001 UMI_ENV=dev MOCK=none max dev",
    "start:dev": "cross-env PORT=8001 REACT_APP_ENV=dev UMI_ENV=dev MOCK=none max dev",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:update": "vitest run -u",
    "tsc": "max setup && tsc --noEmit"
  },
  "browserslist": [
    "Chrome >= 120",
    "Edge >= 120",
    "Firefox >= 121",
    "Safari >= 17.4"
  ],
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/pro-components": "3.1.14-6",
    "@tanstack/react-query": "5.101.4",
    "antd": "6.6.0",
    "antd-style": "4.1.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@umijs/max": "4.7.5",
    "@umijs/max-plugin-openapi": "2.0.3",
    "cross-env": "10.1.0",
    "happy-dom": "20.11.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.34.5"
  }
}
