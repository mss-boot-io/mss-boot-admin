{
  "apiVersion": "mss.io/v1alpha1",
  "kind": "RetirementInventorySource",
  "metadata": {
    "name": "admin-antd-v5-retirement",
    "feature": ".mss/features/admin-antd-v6-cutover-retirement.yaml",
    "owner": "admin-platform"
  },
  "spec": {
    "reportPath": ".mss/reports/admin-antd-v5-retirement-inventory.json",
    "decisions": [
      "remove",
      "retain",
      "defer"
    ],
    "candidates": [
      {
        "id": "v5-application-source",
        "category": "frontend",
        "decision": "remove",
        "gate": "post-observation-breaking-pr",
        "definingSources": [
          "web/antd/package.json",
          "web/antd/config/config.ts",
          "web/antd/src/app.tsx"
        ],
        "runtimeRegistrations": [
          ".mss/project.yaml",
          ".mss/dev.yaml"
        ],
        "knownConsumers": [
          "Makefile",
          ".github/workflows/frontend-ci.yml"
        ],
        "permissions": [],
        "configurationKeys": [
          "frontend application id antd-v5",
          "development port 8000",
          "localStorage token/token.expire/autoLogin"
        ],
        "databaseMetadata": [],
        "replacement": "The independently built Ant Design 6 application retains all supported Admin browser capabilities.",
        "replacementPaths": [
          "web/antd-v6/package.json",
          "web/antd-v6/config/config.ts",
          "web/antd-v6/src/app.tsx"
        ],
        "rationale": "Remove only after V6 is the observed default and the frozen V5 image has completed its rollback window."
      },
      {
        "id": "v5-ci-release-and-deploy",
        "category": "delivery",
        "decision": "remove",
        "gate": "post-observation-breaking-pr",
        "definingSources": [
          ".github/workflows/frontend-ci.yml",
          ".github/workflows/frontend-release.yml",
          ".github/workflows/frontend-deploy.yml",
          "web/antd/Dockerfile",
          "web/antd/nginx.conf"
        ],
        "runtimeRegistrations": [
          ".github/workflows/ci.yml",
          ".github/workflows/release.yml",
          ".github/workflows/release-readiness.yml"
        ],
        "knownConsumers": [
          ".mss/release-policy.yaml",
          ".mss/blueprints/management-system.yaml"
        ],
        "permissions": [],
        "configurationKeys": [
          "web/antd/v{version}",
          "mss-boot-admin-antd"
        ],
        "databaseMetadata": [],
        "replacement": "Use the independent V6 CI, tag, release artifact, image, and Nginx delivery contract.",
        "replacementPaths": [
          ".github/workflows/frontend-v6-ci.yml",
          ".github/workflows/frontend-v6-release.yml",
          "web/antd-v6/Dockerfile",
          "web/antd-v6/nginx.conf"
        ],
        "rationale": "Retire active V5 delivery surfaces together without renaming or mutating the V6 artifact identity."
      },
      {
        "id": "v5-root-release-embedding",
        "category": "delivery",
        "decision": "remove",
        "gate": "v6-default-pr",
        "definingSources": [
          ".github/workflows/release.yml"
        ],
        "runtimeRegistrations": [
          ".mss/release-policy.yaml"
        ],
        "knownConsumers": [
          ".github/workflows/release-readiness.yml"
        ],
        "permissions": [],
        "configurationKeys": [
          "frontend-dist",
          "web/antd/dist"
        ],
        "databaseMetadata": [],
        "replacement": "The backend release must consume an explicitly selected immutable V6 artifact or omit frontend embedding; V6 publication remains independent.",
        "replacementPaths": [
          ".github/workflows/frontend-v6-release.yml"
        ],
        "rationale": "The default switch must stop producing a new V5 bundle while retaining the last immutable V5 release for rollback."
      },
      {
        "id": "v5-dependency-automation",
        "category": "tooling",
        "decision": "remove",
        "gate": "post-observation-breaking-pr",
        "definingSources": [
          ".github/dependabot.yml"
        ],
        "runtimeRegistrations": [],
        "knownConsumers": [
          "web/antd/pnpm-lock.yaml"
        ],
        "permissions": [],
        "configurationKeys": [
          "dependabot directory /web/antd"
        ],
        "databaseMetadata": [],
        "replacement": "V6 dependency automation and its independent lockfile remain active.",
        "replacementPaths": [
          "web/antd-v6/pnpm-lock.yaml"
        ],
        "rationale": "Keeping dependency automation for deleted source creates misleading security and maintenance ownership."
      },
      {
        "id": "v5-generator-projection",
        "category": "generation",
        "decision": "defer",
        "gate": "published-downstream-breaking-boundary",
        "definingSources": [
          "internal/mss/spec/module.go",
          "internal/mss/generator/generator.go",
          "internal/mss/app/app.go",
          "internal/mss/mcp/server.go",
          "templates/module/frontend"
        ],
        "runtimeRegistrations": [
          ".mss/schemas/admin-module.schema.json",
          ".mss/commands.yaml"
        ],
        "knownConsumers": [
          ".mss/modules/example-supplier.yaml",
          ".github/workflows/agent-native-ci.yml",
          "templates/module/docs/module.md.tmpl"
        ],
        "permissions": [],
        "configurationKeys": [
          "frontend target antd-v5",
          "default frontend target antd-v5"
        ],
        "databaseMetadata": [],
        "replacement": "Make antd-v6 the sole generator target only after publishing the last V5-compatible foundation and downstream upgrade instructions.",
        "replacementPaths": [
          "templates/module/frontend-v6",
          "web/antd-v6/src/generated"
        ],
        "rationale": "Generated downstream applications may still declare V5; repository cutover alone does not prove those consumers have upgraded."
      },
      {
        "id": "v5-active-documentation",
        "category": "documentation",
        "decision": "remove",
        "gate": "post-observation-breaking-pr",
        "definingSources": [
          "web/antd/README.md",
          "web/antd/README.zh-CN.md"
        ],
        "runtimeRegistrations": [
          ".mss/capabilities.yaml"
        ],
        "knownConsumers": [
          "docs/docs/admin"
        ],
        "permissions": [],
        "configurationKeys": [],
        "databaseMetadata": [],
        "replacement": "Active documentation names V6 as the Admin frontend; immutable historical release notes and archived migration evidence remain.",
        "replacementPaths": [
          "docs/docs/admin/ant-design-v6-migration-plan.md",
          "web/antd-v6/README.md"
        ],
        "rationale": "Only active guidance is rewritten; historical tags, changelogs, and release evidence are not altered."
      },
      {
        "id": "v5-browser-bearer-storage",
        "category": "browser-authentication",
        "decision": "remove",
        "gate": "post-observation-breaking-pr",
        "definingSources": [
          "web/antd/src/utils/authStorage.ts",
          "web/antd/src/requestErrorConfig.ts",
          "web/antd/src/pages/User/Login/index.tsx"
        ],
        "runtimeRegistrations": [
          "web/antd/src/app.tsx"
        ],
        "knownConsumers": [
          "web/antd/src/hooks/useWebSocket.ts",
          "web/antd/src/services/admin/user.ts"
        ],
        "permissions": [],
        "configurationKeys": [
          "localStorage token",
          "localStorage token.expire",
          "localStorage autoLogin"
        ],
        "databaseMetadata": [],
        "replacement": "V6 uses an HttpOnly browser session, signed CSRF token, scheduled refresh, and a one-time WebSocket ticket.",
        "replacementPaths": [
          "web/antd-v6/src/shared/auth/session.ts",
          "web/antd-v6/src/shared/auth/SessionRefreshBridge.tsx",
          "web/antd-v6/src/shared/realtime/socket.ts"
        ],
        "rationale": "This browser storage behavior disappears with V5 source; it does not authorize removal of general bearer API authentication."
      },
      {
        "id": "general-rest-bearer-authentication",
        "category": "api-authentication",
        "decision": "retain",
        "gate": "independent-api-deprecation-only",
        "definingSources": [
          "admin/middleware/auth.go"
        ],
        "runtimeRegistrations": [
          "admin/router/router.go"
        ],
        "knownConsumers": [
          "docs/docs/admin/integration-test-guide.md",
          "docs/docs/admin/operations-guide.md"
        ],
        "permissions": [
          "Casbin route and action policies",
          "personal access token scopes"
        ],
        "configurationKeys": [
          "Authorization: Bearer"
        ],
        "databaseMetadata": [
          "user authentication tokens",
          "personal access token hashes",
          "Casbin API policies"
        ],
        "replacement": "No replacement: documented non-browser API clients continue to use supported bearer or PAT authentication.",
        "replacementPaths": [
          "admin/middleware/auth.go"
        ],
        "rationale": "Retiring a browser implementation is not evidence that API automation no longer exists."
      },
      {
        "id": "legacy-bearer-login-and-refresh-routes",
        "category": "api-authentication",
        "decision": "retain",
        "gate": "independent-api-deprecation-only",
        "definingSources": [
          "admin/apis/user.go",
          "admin/middleware/auth.go"
        ],
        "runtimeRegistrations": [
          "admin/apis/user.go"
        ],
        "knownConsumers": [
          "web/antd/src/services/admin/user.ts",
          "docs/docs/admin/integration-test-guide.md"
        ],
        "permissions": [],
        "configurationKeys": [
          "POST /admin/api/user/login",
          "POST /admin/api/user/refresh-token"
        ],
        "databaseMetadata": [
          "server-side user sessions"
        ],
        "replacement": "V6 browsers use the session endpoints, while bearer-capable API clients retain the existing login and refresh contract.",
        "replacementPaths": [
          "admin/middleware/browser_session.go",
          "web/antd-v6/src/shared/auth/session.ts"
        ],
        "rationale": "The V5 caller is removed later, but the endpoint requires a separate external-consumer deprecation decision."
      },
      {
        "id": "legacy-bearer-oauth-response-mode",
        "category": "oauth",
        "decision": "defer",
        "gate": "api-client-owner-confirmation",
        "definingSources": [
          "admin/apis/oauth.go",
          "admin/apis/user.go"
        ],
        "runtimeRegistrations": [
          "admin/apis/user.go"
        ],
        "knownConsumers": [
          "web/antd/src/utils/oauth.ts",
          "web/antd/src/services/admin/user.ts"
        ],
        "permissions": [
          "authenticated binding and reauthentication intents"
        ],
        "configurationKeys": [
          "POST /admin/api/user/oauth2/authorize",
          "POST /admin/api/user/:provider/callback"
        ],
        "databaseMetadata": [
          "OAuth attempt state",
          "user OAuth identities"
        ],
        "replacement": "V6 browser OAuth uses transport-bound session endpoints that never return the Admin JWT.",
        "replacementPaths": [
          "web/antd-v6/src/pages/User/OAuthCallback/index.tsx",
          "admin/apis/oauth.go"
        ],
        "rationale": "The V5 browser caller can be removed, but an unknown API client may still depend on the bearer response mode."
      },
      {
        "id": "legacy-oauth-provider-settings",
        "category": "oauth-configuration",
        "decision": "defer",
        "gate": "v5-rollback-expired-and-owner-confirmed",
        "definingSources": [
          "admin/apis/oauth.go",
          "admin/service/app_config.go"
        ],
        "runtimeRegistrations": [
          "admin/apis/oauth.go"
        ],
        "knownConsumers": [
          "web/antd/src/pages/AppConfig/components/security.tsx"
        ],
        "permissions": [
          "application configuration security read/write"
        ],
        "configurationKeys": [
          "security:githubClientId",
          "security:githubClientSecret",
          "security:githubRedirectURI",
          "security:larkAppId",
          "security:larkAppSecret",
          "security:larkRedirectURI"
        ],
        "databaseMetadata": [
          "application configuration security records"
        ],
        "replacement": "V6 uses the separate BrowserSession OAuth client IDs, secrets, and redirect URIs.",
        "replacementPaths": [
          "web/antd-v6/src/modules/app-config/SecurityPanel.tsx",
          "admin/apis/oauth.go"
        ],
        "rationale": "Secret records cannot be deleted until the V5 rollback window closes and provider owners confirm no non-browser OAuth client uses them."
      },
      {
        "id": "legacy-query-token-websocket",
        "category": "websocket-authentication",
        "decision": "defer",
        "gate": "consumer-audit-and-observation",
        "definingSources": [
          "admin/apis/ws.go",
          "admin/middleware/auth.go"
        ],
        "runtimeRegistrations": [
          "admin/apis/ws.go"
        ],
        "knownConsumers": [
          "web/antd/src/hooks/useWebSocket.ts",
          "web/antd/src/contexts/NotificationContext.tsx"
        ],
        "permissions": [
          "authenticated WebSocket connection"
        ],
        "configurationKeys": [
          "GET /admin/api/ws/connect?token=...",
          "auth.browserSession.legacyWebSocketQueryTokenEnabled"
        ],
        "databaseMetadata": [],
        "replacement": "V6 obtains a short-lived one-time ticket and sends it in Sec-WebSocket-Protocol to /admin/api/ws/connect-v6.",
        "replacementPaths": [
          "admin/apis/ws.go",
          "web/antd-v6/src/shared/realtime/socket.ts"
        ],
        "rationale": "Disable the compatibility switch first, observe explicit Gone responses and consumer telemetry, then unregister the route in a later PR."
      },
      {
        "id": "historical-jwt-cookie-reader",
        "category": "browser-authentication",
        "decision": "defer",
        "gate": "cookie-consumer-observation",
        "definingSources": [
          "admin/middleware/auth.go",
          "admin/middleware/browser_session.go"
        ],
        "runtimeRegistrations": [
          "admin/middleware/auth.go"
        ],
        "knownConsumers": [
          "admin/middleware/browser_session_test.go"
        ],
        "permissions": [],
        "configurationKeys": [
          "cookie jwt"
        ],
        "databaseMetadata": [],
        "replacement": "The only supported browser cookie is mss_admin_session paired with mss_csrf.",
        "replacementPaths": [
          "admin/middleware/browser_session.go"
        ],
        "rationale": "V5 stores a bearer token rather than emitting this cookie, but downstream historical deployments must still be measured before removal."
      },
      {
        "id": "missing-role-authorization-if-match",
        "category": "optimistic-concurrency",
        "decision": "defer",
        "gate": "mutation-consumer-audit",
        "definingSources": [
          "admin/apis/authorize_helper.go",
          "admin/apis/role.go",
          "admin/apis/menu.go"
        ],
        "runtimeRegistrations": [
          "admin/apis/role.go",
          "admin/apis/menu.go"
        ],
        "knownConsumers": [
          "web/antd/src/pages/Role/index.tsx",
          "web/antd-v6/src/modules/administration/api.ts"
        ],
        "permissions": [
          "root-only role and menu authorization mutations"
        ],
        "configurationKeys": [
          "optional If-Match compatibility warning"
        ],
        "databaseMetadata": [
          "role authorization revision",
          "Casbin menu and API policies"
        ],
        "replacement": "Require the current strong role-authorization ETag on every supported mutation client.",
        "replacementPaths": [
          "web/antd-v6/src/modules/administration/api.ts"
        ],
        "rationale": "V6 sends the precondition, but external automation and generated V5 clients require explicit audit before the backend fails missing headers."
      },
      {
        "id": "missing-option-if-match-and-body-revision",
        "category": "optimistic-concurrency",
        "decision": "defer",
        "gate": "mutation-consumer-audit",
        "definingSources": [
          "admin/apis/option.go"
        ],
        "runtimeRegistrations": [
          "admin/apis/option.go"
        ],
        "knownConsumers": [
          "web/antd/src/pages/Option/index.tsx",
          "web/antd-v6/src/modules/option/api.ts"
        ],
        "permissions": [
          "option update and delete permissions"
        ],
        "configurationKeys": [
          "optional If-Match",
          "expectedVersion",
          "legacy version body field"
        ],
        "databaseMetadata": [
          "option resource version",
          "option history snapshots"
        ],
        "replacement": "Require the strong option ETag and remove legacy body revisions after every supported mutation client sends If-Match.",
        "replacementPaths": [
          "web/antd-v6/src/modules/option/api.ts"
        ],
        "rationale": "Concurrency enforcement becomes safe only after the exact external and downstream mutation-client inventory is complete."
      },
      {
        "id": "legacy-theme-write-compatibility",
        "category": "theme-concurrency",
        "decision": "defer",
        "gate": "theme-client-audit",
        "definingSources": [
          "admin/apis/theme_http.go",
          "admin/service/theme.go"
        ],
        "runtimeRegistrations": [
          "admin/apis/app_config.go",
          "admin/apis/user_config.go"
        ],
        "knownConsumers": [
          "web/antd/src/components/MssBoot/ThemeRuntimeBridge.tsx",
          "web/antd-v6/src/modules/theme/ThemeSettingsEditor.tsx"
        ],
        "permissions": [
          "application theme and current-user theme mutations"
        ],
        "configurationKeys": [
          "optional If-Match",
          "legacy pwa theme field"
        ],
        "databaseMetadata": [
          "application and user theme revisions",
          "legacy pwa theme setting"
        ],
        "replacement": "V6 uses the canonical seven-field ThemeResource contract and a strong scoped ETag.",
        "replacementPaths": [
          "web/antd-v6/src/shared/theme/api.ts",
          "web/antd-v6/src/modules/theme/ThemeSettingsEditor.tsx"
        ],
        "rationale": "Preserve unknown downstream theme writers and stored values until their owners are identified; never delete theme rows by broad key prefix."
      },
      {
        "id": "shared-menu-and-casbin-metadata",
        "category": "authorization-metadata",
        "decision": "retain",
        "gate": "not-v5-specific",
        "definingSources": [
          "admin/models/menu.go",
          "admin/models/casbin_rule.go"
        ],
        "runtimeRegistrations": [
          "admin/apis/menu.go",
          "admin/apis/role.go"
        ],
        "knownConsumers": [
          "web/antd-v6/src/shared/routes/registry.ts",
          "web/antd-v6/src/shared/auth/access.ts"
        ],
        "permissions": [
          "menu paths",
          "API route policies",
          "action permissions"
        ],
        "configurationKeys": [],
        "databaseMetadata": [
          "menus",
          "Casbin rules",
          "role authorization revisions"
        ],
        "replacement": "No replacement: V6 deliberately reuses the backend business-path and authorization metadata while ignoring executable component strings.",
        "replacementPaths": [
          "web/antd-v6/src/shared/routes/registry.ts"
        ],
        "rationale": "Shared authorization records are not V5 data and must not be removed during frontend retirement."
      },
      {
        "id": "v5-local-development-default",
        "category": "local-development",
        "decision": "remove",
        "gate": "v6-default-pr",
        "definingSources": [
          ".mss/dev.yaml",
          ".mss/project.yaml",
          "Makefile"
        ],
        "runtimeRegistrations": [
          "internal/mss/project/context.go",
          "internal/mss/doctor/doctor.go"
        ],
        "knownConsumers": [
          ".mss/commands.yaml",
          ".mss/blueprints/management-system.yaml"
        ],
        "permissions": [],
        "configurationKeys": [
          "repositoryLayout.frontend=web/antd",
          "frontend required=true",
          "frontend-v6 required=false"
        ],
        "databaseMetadata": [],
        "replacement": "The default project, doctor, setup, Make, and development service select web/antd-v6 while V5 remains an explicit rollback-only application during observation.",
        "replacementPaths": [
          "web/antd-v6/package.json",
          "admin/config/application-v6-local.yml"
        ],
        "rationale": "This switch belongs in the separate backward-compatible default PR and must not delete V5 source."
      },
      {
        "id": "v5-origin-and-browser-session-defaults",
        "category": "backend-configuration",
        "decision": "remove",
        "gate": "v6-default-pr-then-post-observation-tightening",
        "definingSources": [
          "admin/config/application.yml",
          "admin/config/application-v6-local.yml",
          "admin/config/auth.go"
        ],
        "runtimeRegistrations": [
          "admin/config/config.go"
        ],
        "knownConsumers": [
          ".mss/dev.yaml",
          "web/antd-v6/config/proxy.ts"
        ],
        "permissions": [],
        "configurationKeys": [
          "CORS localhost:8000",
          "application.origin",
          "auth.sessionEnabled",
          "auth.browserSession.enabled",
          "auth.browserSession.secure"
        ],
        "databaseMetadata": [
          "durable user sessions"
        ],
        "replacement": "V6 becomes the explicit trusted origin with browser sessions enabled; production continues to require HTTPS, Secure cookies, and a strong key.",
        "replacementPaths": [
          "admin/config/application-v6-local.yml",
          "admin/config/auth.go"
        ],
        "rationale": "Switch safe defaults first, keep the V5 origin during rollback observation, and remove it only after traffic and consumer evidence is complete."
      },
      {
        "id": "tracked-v5-test-output",
        "category": "obsolete-artifact",
        "decision": "remove",
        "gate": "next-coherent-cleanup",
        "definingSources": [
          "web/antd/test-results/.last-run.json"
        ],
        "runtimeRegistrations": [],
        "knownConsumers": [],
        "permissions": [],
        "configurationKeys": [],
        "databaseMetadata": [],
        "replacement": "Test output stays ignored and is produced only as ephemeral CI or local evidence.",
        "replacementPaths": [
          "web/antd/.gitignore"
        ],
        "rationale": "This generated Playwright state is already ignored and has no runtime or release consumer."
      }
    ]
  }
}
