{
  "apiVersion": "mss.io/v1alpha1",
  "kind": "FrontendParityInventory",
  "metadata": {
    "name": "admin-antd-v6-parity",
    "feature": ".mss/features/admin-antd-v6-cutover-retirement.yaml",
    "owner": "admin-platform"
  },
  "spec": {
    "sourceApplication": "web/antd",
    "targetApplication": "web/antd-v6",
    "implementationStatus": "pre-pr-qualified",
    "mergedMainQualificationStatus": "pending",
    "capabilities": [
      {
        "id": "browser-authentication",
        "disposition": "replace-with-hardened-v6-contract",
        "status": "implemented",
        "v5Routes": [
          "/user/login",
          "/user/register",
          "/user/forget",
          "/user/callback/:provider"
        ],
        "v6Routes": [
          "/user/login",
          "/user/register",
          "/user/forget",
          "/user/callback/:provider",
          "/user/oauth/callback/:provider"
        ],
        "v6Sources": [
          "web/antd-v6/src/pages/User",
          "web/antd-v6/src/shared/auth/session.ts",
          "web/antd-v6/src/shared/auth/SessionRefreshBridge.tsx",
          "web/antd-v6/src/shared/auth/oauthRedirect.ts"
        ],
        "acceptance": [
          "Password, email challenge, OAuth, safe deep-link redirect, refresh and logout preserve the intended user journey.",
          "Browser credentials use HttpOnly cookies, signed CSRF and scheduled refresh instead of V5 localStorage bearer tokens."
        ]
      },
      {
        "id": "self-service-account-security",
        "disposition": "preserve-and-strengthen",
        "status": "implemented",
        "v5Routes": [
          "/account/center",
          "/account/settings"
        ],
        "v6Routes": [
          "/account/center",
          "/account/settings"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/account",
          "web/antd-v6/src/pages/Account"
        ],
        "acceptance": [
          "Profile, avatar, password, notification preferences, personal theme, PAT lifecycle and OAuth identities remain self-service.",
          "Password changes and OAuth disconnect require recent reauthentication and never expose stored passwords or provider secrets."
        ]
      },
      {
        "id": "workplace-and-monitoring",
        "disposition": "preserve-and-refine",
        "status": "implemented",
        "v5Routes": [
          "/workplace",
          "/welcome",
          "/analysis"
        ],
        "v6Routes": [
          "/workplace",
          "/welcome",
          "/analysis"
        ],
        "v6Sources": [
          "web/antd-v6/src/pages/Workplace/index.tsx",
          "web/antd-v6/src/modules/monitor"
        ],
        "acceptance": [
          "Permission-aware user, department, role, menu, application-setting and log shortcuts are retained alongside personal shortcuts.",
          "Current and stale monitoring samples, retry, permission denied, empty history and runtime details have explicit states."
        ]
      },
      {
        "id": "user-management",
        "disposition": "preserve",
        "status": "implemented",
        "v5Routes": [
          "/users",
          "/users/control/create",
          "/users/control/:id",
          "/users/password-reset/:id"
        ],
        "v6Routes": [
          "/users",
          "/users/control/create",
          "/users/control/:id",
          "/users/password-reset/:id"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/administration/UserManagement.tsx"
        ],
        "acceptance": [
          "List, filter, create, edit, role, department, post, status, avatar and reset actions use named relations and backend-enforced root mutations."
        ]
      },
      {
        "id": "role-and-menu-authorization",
        "disposition": "preserve",
        "status": "implemented",
        "v5Routes": [
          "/role",
          "/role/create",
          "/role/:id",
          "/menu",
          "/menu/create",
          "/menu/:id"
        ],
        "v6Routes": [
          "/role",
          "/role/create",
          "/role/:id",
          "/menu",
          "/menu/create",
          "/menu/:id"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/administration/RoleManagement.tsx",
          "web/antd-v6/src/modules/administration/MenuManagement.tsx"
        ],
        "acceptance": [
          "Authorization trees use localized menu names and a complete unfiltered menu catalog.",
          "Menu parent selection excludes the record and its descendants without depending on the current table page."
        ]
      },
      {
        "id": "department-and-post-management",
        "disposition": "preserve",
        "status": "implemented",
        "v5Routes": [
          "/departments",
          "/departments/create",
          "/departments/:id",
          "/posts",
          "/posts/create",
          "/posts/:id"
        ],
        "v6Routes": [
          "/departments",
          "/departments/create",
          "/departments/:id",
          "/posts",
          "/posts/create",
          "/posts/:id"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/administration/DepartmentManagement.tsx",
          "web/antd-v6/src/modules/administration/PostManagement.tsx"
        ],
        "acceptance": [
          "Relations render names rather than opaque identifiers.",
          "Parent selectors use complete catalogs and exclude self or descendants independently of table filtering and pagination."
        ]
      },
      {
        "id": "tasks",
        "disposition": "preserve-and-harden",
        "status": "implemented",
        "v5Routes": [
          "/task",
          "/task/create",
          "/task/:id"
        ],
        "v6Routes": [
          "/task",
          "/task/create",
          "/task/:id"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/operations/TaskManagement.tsx"
        ],
        "acceptance": [
          "Root users can maintain bounded HTTP, function and Kubernetes definitions; non-root users receive a safe read-only projection.",
          "The UI explains privileged execution, server time-zone scheduling and the difference between saving and enabling."
        ]
      },
      {
        "id": "notices",
        "disposition": "preserve-and-refine",
        "status": "implemented",
        "v5Routes": [
          "/notice"
        ],
        "v6Routes": [
          "/notice"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/operations/NoticeCenter.tsx",
          "web/antd-v6/src/shared/navigation/HeaderNotice.tsx"
        ],
        "acceptance": [
          "Full-page notice management and a V5-familiar header popover share query invalidation and server-owned identity.",
          "Unread, read, empty, error, detail and realtime-refresh states remain available."
        ]
      },
      {
        "id": "logs",
        "disposition": "preserve-and-redact",
        "status": "implemented",
        "v5Routes": [
          "/log"
        ],
        "v6Routes": [
          "/log"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/operations/LogViewer.tsx"
        ],
        "acceptance": [
          "Bounded list, detail, filters, export and redacted evidence are retained.",
          "Known authentication audit messages are localized while unknown diagnostic messages remain intact."
        ]
      },
      {
        "id": "language-management",
        "disposition": "preserve",
        "status": "implemented",
        "v5Routes": [
          "/language",
          "/language/create",
          "/language/:id"
        ],
        "v6Routes": [
          "/language",
          "/language/create",
          "/language/:id"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/language",
          "web/antd-v6/src/pages/Language"
        ],
        "acceptance": [
          "Canonical language resources, optimistic revisions, independent permissions and conflict recovery are retained.",
          "Only shipped zh-CN and en-US catalogs are selectable as complete interface languages."
        ]
      },
      {
        "id": "option-dictionaries",
        "disposition": "preserve-and-localize",
        "status": "implemented",
        "v5Routes": [
          "/option",
          "/option/create",
          "/option/:id"
        ],
        "v6Routes": [
          "/option",
          "/option/create",
          "/option/:id"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/option"
        ],
        "acceptance": [
          "Summary/detail separation, built-in protection, bounded items, revisions and conflict recovery are retained.",
          "Untouched built-in seed labels are localized at presentation time; user-customized values are preserved verbatim."
        ]
      },
      {
        "id": "application-system-and-theme-settings",
        "disposition": "preserve-and-modernize",
        "status": "implemented",
        "v5Routes": [
          "/app-config",
          "/system-config",
          "/system-config/create",
          "/system-config/:id"
        ],
        "v6Routes": [
          "/app-config",
          "/system-config",
          "/system-config/create",
          "/system-config/:id"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/app-config",
          "web/antd-v6/src/modules/operations/SystemConfigManagement.tsx",
          "web/antd-v6/src/modules/theme",
          "web/antd-v6/src/shared/theme"
        ],
        "acceptance": [
          "Base, security, storage, email and theme settings are complete; secrets use blind rotation and are never refilled.",
          "Application and personal theme precedence, exact revisions, first-paint hints and V6-isolated cross-tab synchronization are retained."
        ]
      },
      {
        "id": "online-sessions",
        "disposition": "preserve-and-strengthen",
        "status": "implemented",
        "v5Routes": [
          "/security/online-sessions"
        ],
        "v6Routes": [
          "/security/online-sessions"
        ],
        "v6Sources": [
          "web/antd-v6/src/modules/session",
          "admin/apis/online_session.go"
        ],
        "acceptance": [
          "Root-only list, filters, details, single-session revoke and all-user-session revoke are retained.",
          "Current session and readable device summaries are explicit while full user-agent evidence remains available in details."
        ]
      },
      {
        "id": "responsive-localized-shell",
        "disposition": "replace-v5-implementation",
        "status": "implemented",
        "v5Routes": [
          "all retained routes"
        ],
        "v6Routes": [
          "all retained routes",
          "/403",
          "/*"
        ],
        "v6Sources": [
          "web/antd-v6/src/app.tsx",
          "web/antd-v6/src/shared/design-system",
          "web/antd-v6/src/locales",
          "web/antd-v6/src/shared/theme/ThemeRuntimeProvider.tsx"
        ],
        "acceptance": [
          "Pages expose one semantic h1, the mobile navigation trigger is a real labelled button, and primary flows work at narrow widths.",
          "Ant Design receives the active zh-CN or en-US locale and V6 avoids internal DOM selectors, raw locale keys and V5 storage namespaces."
        ]
      },
      {
        "id": "generated-supplier-golden",
        "disposition": "retain-as-development-time-evidence-only",
        "status": "implemented",
        "v5Routes": [
          "/suppliers"
        ],
        "v6Routes": [
          "/suppliers"
        ],
        "v6Sources": [
          "templates/module/frontend-v6",
          "web/antd-v6/src/generated/modules/supplier"
        ],
        "acceptance": [
          "The deterministic V6 generator golden remains testable without exposing Supplier or procurement menus in a reference installation.",
          "Unused generated finance and procurement roles are removed only by exact provenance after assignment and policy safety checks."
        ]
      }
    ],
    "intentionalExclusions": [
      {
        "id": "runtime-dynamic-model-and-browser-codegen",
        "decision": "removed-product-feature",
        "reason": "The repository contract forbids reintroducing the removed runtime developer tools; deterministic cmd/mss generation is the supported replacement."
      },
      {
        "id": "supplier-procurement-reference-menu",
        "decision": "generator-evidence-only",
        "reason": "Supplier remains a generation golden but is not a reference-product business module and must not seed menus or demo roles."
      },
      {
        "id": "ant-design-pro-demo-and-ai-pages",
        "decision": "not-a-product-requirement",
        "reason": "Official preview demo pages, analytics, AI assistant and external sample integrations are not MSS capabilities."
      }
    ],
    "rejectedV5Defects": [
      {
        "id": "opaque-relation-identifiers",
        "replacement": "Resolve and render relation names while retaining identifiers only as transport keys."
      },
      {
        "id": "page-dependent-parent-options",
        "replacement": "Use independent complete catalogs and exclude self or descendants before mutation."
      },
      {
        "id": "persistent-browser-bearer-token",
        "replacement": "Use the V6 HttpOnly browser-session and signed CSRF contract."
      },
      {
        "id": "query-token-websocket",
        "replacement": "Use a short-lived single-use V6 ticket carried in Sec-WebSocket-Protocol."
      },
      {
        "id": "raw-locale-keys-and-hard-coded-fallback-copy",
        "replacement": "Synchronize zh-CN and en-US catalogs and fail through product-safe localized states."
      },
      {
        "id": "private-ant-dom-and-less-overrides",
        "replacement": "Use Ant Design 6 tokens, semantic slots, CSS variables and owned layout styles."
      }
    ]
  }
}
