{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mss.io/schemas/admin-distribution.schema.json",
  "title": "MSS Admin Distribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "backend", "frontend"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "version"],
      "properties": {
        "module": { "type": "string", "minLength": 3 },
        "version": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "type": "string", "minLength": 3 },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
