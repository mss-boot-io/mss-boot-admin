{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mss-boot.io/schemas/admin-presentation-catalog.v1alpha1.json",
  "title": "mss Admin Presentation Catalog",
  "description": "Closed Foundation-owned compatibility catalog for generated version 2 Admin presentation capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mss.io/v1alpha1" },
    "kind": { "const": "AdminPresentationCatalog" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definitionVersion"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "definitionVersion": { "const": "2" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "dataSources", "actions"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "dataSources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dataSource" }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "valueTypes", "formats", "surfaces", "readOnly"],
      "properties": {
        "id": { "$ref": "#/$defs/localID" },
        "valueTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["string", "enum", "boolean", "integer", "number", "date", "date-time", "json"]
          }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["plain", "email", "identifier", "date", "date-time"]
          }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/surface" }
        },
        "readOnly": {
          "type": "string",
          "enum": ["any", "required", "forbidden"]
        }
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "apiOperation", "permissionAction", "pageSizeOptions", "maxPageSize", "maxSortFields"],
      "properties": {
        "id": { "$ref": "#/$defs/localID" },
        "apiOperation": { "$ref": "#/$defs/localID" },
        "permissionAction": { "$ref": "#/$defs/localID" },
        "pageSizeOptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 200 }
        },
        "maxPageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxSortFields": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "apiOperation", "permissionAction", "placements", "destructive"],
      "properties": {
        "id": { "$ref": "#/$defs/localID" },
        "apiOperation": { "$ref": "#/$defs/localID" },
        "permissionAction": { "$ref": "#/$defs/localID" },
        "placements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/actionPlacement" }
        },
        "destructive": { "type": "boolean" }
      }
    },
    "localID": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "surface": {
      "type": "string",
      "enum": ["list", "search", "form", "detail"]
    },
    "actionPlacement": {
      "type": "string",
      "enum": ["toolbar", "row", "form", "detail"]
    }
  }
}
