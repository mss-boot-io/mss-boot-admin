{{- end }}
                      setFilters(initialFilters);
                      setParams(build{{ .ModelName }}Query(1, {{ if .Presentation.Enabled }}presentation.list.pageSize{{ else }}20{{ end }}, initialFilters));
                    }}
                  >
                    {intl.formatMessage({ id: `${localePrefix}.actions.reset` })}
                  </Button>
                </Space>
              </Form.Item>
            </Col>
          </Row>
        </Form>
{{- if .Presentation.Enabled }}
        )}
{{- end }}
        <Row justify="space-between" gutter={[12, 12]}>
          <Col>
            <Typography.Title level={4} className="m-0">
              {intl.formatMessage({ id: `${localePrefix}.list.title` })}
            </Typography.Title>
          </Col>
          <Col>
            <Space wrap>
{{- if .HasExport }}
              {capabilities.canExport{{ if .Presentation.Enabled }} && presentationAction('{{ .ModuleName }}.export', 'toolbar', searchConditionValues){{ end }} ? (
                <Button
                  aria-label={intl.formatMessage({ id: `${localePrefix}.actions.export` })}
                  icon={<DownloadOutlined />}
                  loading={exportRecords.isPending}
{{- if .Presentation.Enabled }}
                  style={ { order: presentationAction('{{ .ModuleName }}.export', 'toolbar', searchConditionValues)?.order } }
{{- end }}
                  onClick={() => exportRecords.mutate()}
                >
                  {{ if .Presentation.Enabled }}{presentationAction('{{ .ModuleName }}.export', 'toolbar', searchConditionValues)?.label}{{ else }}{intl.formatMessage({ id: `${localePrefix}.actions.export` })}{{ end }}
                </Button>
              ) : null}
{{- end }}
{{- if .HasCreate }}
              {capabilities.canCreate{{ if .Presentation.Enabled }} && presentationAction('{{ .ModuleName }}.create', 'toolbar', searchConditionValues){{ end }} ? (
                <Button
                  aria-label={intl.formatMessage({ id: `${localePrefix}.actions.create` })}
                  icon={<PlusOutlined />}
{{- if .Presentation.Enabled }}
                  style={ { order: presentationAction('{{ .ModuleName }}.create', 'toolbar', searchConditionValues)?.order } }
{{- end }}
                  type="primary"
                  onClick={openCreate}
                >
                  {{ if .Presentation.Enabled }}{presentationAction('{{ .ModuleName }}.create', 'toolbar', searchConditionValues)?.label}{{ else }}{intl.formatMessage({ id: `${localePrefix}.actions.create` })}{{ end }}
                </Button>
              ) : null}
{{- end }}
            </Space>
          </Col>
        </Row>
        <Table<{{ .ModelName }}>
          columns={columns}
          dataSource={list.data?.data ?? []}
          loading={list.isFetching}
          locale={ {
            emptyText: <PageEmpty description={intl.formatMessage({ id: `${localePrefix}.states.empty` })} />,
          } }
          pagination={ {
            current: params.current,
            pageSize: params.pageSize,
            pageSizeOptions: pageSizes,
            showSizeChanger: true,
            total: list.data?.total ?? 0,
          } }
{{- if .Presentation.Enabled }}
          size={presentation.list.density === 'compact' ? 'small' : presentation.list.density}
{{- end }}
          rowKey="id"
          scroll={ { x: 'max-content' } }
          onChange={handleTableChange}
        />
      </Space>

{{- if or .HasCreate .HasUpdate }}
      <Modal
        destroyOnHidden
        open={editorOpen}
        title={intl.formatMessage({
          id: `${localePrefix}.actions.${editorRecord ? 'edit' : 'create'}`,
        })}
        okButtonProps={ {
          form: '{{ .ModuleName }}-editor',
          htmlType: 'submit',
          loading: save.isPending,
{{- if and .Presentation.Enabled .HasUpdate }}
          ...(editorRecord && presentationAction('{{ .ModuleName }}.update', 'form', formDraft)
            ? { style: { display: 'none' } }
            : {}),
{{- end }}
        } }
        onCancel={() => {
          setEditorOpen(false);
          setEditorRecord(undefined);
          setConflict(false);
          save.reset();
        }}
      >
        <Form<Create{{ .ModelName }}Input>
{{- if .Presentation.Enabled }}
          form={editorForm}
{{- end }}
          initialValues={editorRecord ?? createDefaults}
          key={editorSession}
          layout="vertical"
          name="{{ .ModuleName }}-editor"
          preserve={false}
          onFinish={(values) => save.mutate(values)}
        >
          {conflict ? (
            <Alert
              className="mb-4"
              showIcon
              title={intl.formatMessage({ id: `${localePrefix}.errors.conflict` })}
              type="warning"
            />
          ) : null}
          {save.isError && !conflict ? (
            <Alert
              className="mb-4"
              description={getRequestErrorMessage(save.error)}
              showIcon
              title={intl.formatMessage({ id: `${localePrefix}.errors.request` })}
              type="error"
            />
          ) : null}
{{- if .Presentation.Enabled }}
          <div style={ { display: 'flex', flexWrap: 'wrap' } }>
{{- end }}
{{- range .Fields }}{{ if .Form }}
{{- if $.Presentation.Enabled }}
          {visibleField(
            presentation.form.fields.find((field) => field.field === '{{ .JSONName }}'),
            formDraft,
          ) ? (
            <div
              style={ {
                order: presentation.form.fields.find((field) => field.field === '{{ .JSONName }}')?.order,
                width: `${((presentation.form.fields.find((field) => field.field === '{{ .JSONName }}')?.span ?? Math.floor(24 / presentation.form.columns)) / 24) * 100}%`,
              } }
            >
{{- end }}
          <Form.Item
            name="{{ .JSONName }}"
{{- if $.Presentation.Enabled }}
            label={presentation.form.fields.find((field) => field.field === '{{ .JSONName }}')?.label ?? intl.formatMessage({ id: `${localePrefix}.fields.{{ .JSONName }}` })}
{{- else }}
            label={intl.formatMessage({ id: `${localePrefix}.fields.{{ .JSONName }}` })}
{{- end }}
{{- if $.Presentation.Enabled }}
            help={presentation.form.fields.find((field) => field.field === '{{ .JSONName }}')?.help}
{{- end }}
{{- if .IsBool }}
            valuePropName="checked"
{{- end }}
            rules={[
{{- if .Required }}
              {
                required: true,
                message: intl.formatMessage({ id: `${localePrefix}.validation.{{ .JSONName }}.required` }),
              },
{{- end }}
{{- if .HasMinLength }}
              {
                min: {{ .MinLength }},
                message: intl.formatMessage({ id: `${localePrefix}.validation.{{ .JSONName }}.minLength` }),
              },
{{- end }}
{{- if .HasMaxLength }}
              {
                max: {{ .MaxLength }},
                message: intl.formatMessage({ id: `${localePrefix}.validation.{{ .JSONName }}.maxLength` }),
              },
{{- end }}
{{- if .HasPattern }}
              {
                pattern: {{ if $.Presentation.Enabled }}compilePortablePresentationPattern({{ .PatternTS }}){{ else }}new RegExp({{ .PatternTS }}){{ end }},
                message: intl.formatMessage({ id: `${localePrefix}.validation.{{ .JSONName }}.pattern` }),
              },
{{- end }}
{{- if .EmailFormat }}
              {
                type: 'email',
                message: intl.formatMessage({ id: `${localePrefix}.validation.{{ .JSONName }}.email` }),
              },
{{- end }}
            ]}
          >
{{- if $.Presentation.Enabled }}
            <PresentationFieldControl
              allLabel={intl.formatMessage({ id: `${localePrefix}.values.all` })}
              component={presentation.form.fields.find((field) => field.field === '{{ .JSONName }}')?.component ?? 'input'}
              disabledLabel={intl.formatMessage({ id: `${localePrefix}.values.disabled` })}
              enabledLabel={intl.formatMessage({ id: `${localePrefix}.values.enabled` })}
{{- if .HasMaxLength }}
              maxLength={ {{ .MaxLength }} }
{{- end }}
{{- if .IsEnum }}
              options={ {{ .JSONName }}Options }
{{- end }}
              placeholder={presentation.form.fields.find((field) => field.field === '{{ .JSONName }}')?.placeholder{{ if .UIPlaceholder }} ?? {{ .UIPlaceholder }}{{ end }}}
            />
{{- else }}
{{- if .IsEnum }}
            <Select options={ {{ .JSONName }}Options } virtual={false} />
{{- else if .IsBool }}
            <Switch />
{{- else if or (eq .UIComponent "textarea") (eq .SpecType "text") }}
            <Input.TextArea{{ if .HasMaxLength }} maxLength={ {{ .MaxLength }} }{{ end }} showCount />
{{- else }}
            <Input autoComplete="off"{{ if $.Presentation.Enabled }} placeholder={presentation.form.fields.find((field) => field.field === '{{ .JSONName }}')?.placeholder{{ if .UIPlaceholder }} ?? {{ .UIPlaceholder }}{{ end }}}{{ else if .UIPlaceholder }} placeholder={{ .UIPlaceholder }}{{ end }} />
{{- end }}
{{- end }}
          </Form.Item>
{{- if $.Presentation.Enabled }}
            </div>
          ) : null}
{{- end }}
{{- end }}{{- end }}
{{- if .Presentation.Enabled }}
          </div>
{{- if .HasUpdate }}
          {editorRecord && capabilities.canUpdate ? (() => {
            const action = presentationAction('{{ .ModuleName }}.update', 'form', formDraft);
            if (!action) return null;
            const submit = (
              <Button
                htmlType={action.confirm ? 'button' : 'submit'}
                loading={save.isPending}
                style={ { order: action.order } }
                type="primary"
              >
                {action.label}
              </Button>
            );
            return action.confirm ? (
              <Popconfirm title={action.confirm} onConfirm={() => editorForm.submit()}>
                {submit}
              </Popconfirm>
            ) : submit;
          })() : null}
{{- end }}
{{- end }}
        </Form>
      </Modal>
{{- end }}

{{- if .HasGet }}
      <Drawer
        destroyOnHidden
        open={Boolean(detailID)}
        size="large"
        title={intl.formatMessage({ id: `${localePrefix}.actions.detail` })}
        onClose={() => setDetailID(undefined)}
      >
        {detail.isPending && !detail.data ? (
          <PageLoading rows={8} />
        ) : getRequestStatus(detail.error) === 403 ? (
          <PageForbidden message={intl.formatMessage({ id: `${localePrefix}.states.forbidden` })} />
        ) : getRequestStatus(detail.error) === 404 ? (
          <Result status="404" subTitle={intl.formatMessage({ id: `${localePrefix}.states.notFound` })} />
        ) : detail.isError && !detail.data ? (
          <PageError
            message={getRequestErrorMessage(detail.error)}
            onRetry={() => void detail.refetch()}
            retryLabel={intl.formatMessage({ id: `${localePrefix}.actions.retry` })}
            title={intl.formatMessage({ id: `${localePrefix}.states.error` })}
          />
        ) : detail.data ? (
          <Space orientation="vertical" size="middle" className="w-full">
            {detail.isError ? (
              <Alert showIcon title={intl.formatMessage({ id: `${localePrefix}.states.refreshFailed` })} type="warning" />
            ) : null}
{{- if .Presentation.Enabled }}
{{- if .HasGet }}
            {capabilities.canRead ? (() => {
              const action = presentationAction(
                '{{ .ModuleName }}.read',
                'detail',
                detail.data as unknown as Readonly<Record<string, unknown>>,
              );
              if (!action) return null;
              const refresh = (
                <Button loading={detail.isFetching} style={ { order: action.order } } onClick={() => void detail.refetch()}>
                  {action.label}
                </Button>
              );
              return action.confirm ? (
                <Popconfirm title={action.confirm} onConfirm={() => void detail.refetch()}>
                  {refresh}
                </Popconfirm>
              ) : refresh;
            })() : null}
{{- end }}
{{- end }}
            <Descriptions
              bordered
              column={{ if .Presentation.Enabled }}{presentation.detail.columns}{{ else }}{1}{{ end }}
              size="small"
{{- if .Presentation.Enabled }}
              items={(() => {
                const compiledItems = [
{{- else }}
              items={[
{{- end }}
                {
                  key: 'id',
                  label: intl.formatMessage({ id: `${localePrefix}.fields.id` }),
                  children: <Typography.Text copyable code>{detail.data.id}</Typography.Text>,
                },
{{- range .Fields }}{{ if .Detail }}
                {
                  key: '{{ .JSONName }}',
                  label: intl.formatMessage({ id: `${localePrefix}.fields.{{ .JSONName }}` }),
{{- if .IsEnum }}
                  children: (() => {
                    const option = {{ .JSONName }}Options.find((entry) => entry.value === detail.data?.{{ .JSONName }});
                    return option ? <Tag color={option.color}>{option.label}</Tag> : detail.data?.{{ .JSONName }};
                  })(),
{{- else if .IsBool }}
                  children: intl.formatMessage({
                    id: `${localePrefix}.values.${detail.data.{{ .JSONName }} ? 'enabled' : 'disabled'}`,
                  }),
{{- else }}
                  children: detail.data.{{ .JSONName }} || '—',
{{- end }}
                },
{{- end }}{{- end }}
                {
                  key: 'createdAt',
                  label: intl.formatMessage({ id: `${localePrefix}.fields.createdAt` }),
                  children: formatDate(detail.data.createdAt),
                },
                {
                  key: 'updatedAt',
                  label: intl.formatMessage({ id: `${localePrefix}.fields.updatedAt` }),
                  children: formatDate(detail.data.updatedAt),
                },
{{- if .Presentation.Enabled }}
                ];
                const byField = new Map(compiledItems.map((item) => [item.key, item]));
                return presentation.detail.fields.flatMap((field) => {
                  const item = byField.get(field.field);
                  if (!item || !visibleField(field, detail.data as Readonly<Record<string, unknown>>)) {
                    return [];
                  }
                  const gridSpan = field.span
                    ? Math.max(
                        1,
                        Math.min(
                          presentation.detail.columns,
                          Math.ceil(field.span / (24 / presentation.detail.columns)),
                        ),
                      )
                    : 1;
                  return [
                    {
                      ...item,
                      label: field.label,
                      span: gridSpan,
                      children: renderPresentationValue({
                        component: field.component,
                        value: (detail.data as unknown as Readonly<Record<string, unknown>>)[field.field],
{{- range .Fields }}{{ if .IsEnum }}
                        ...(field.field === '{{ .JSONName }}' ? { options: {{ .JSONName }}Options } : {}),
{{- end }}{{- end }}
                        enabledLabel: intl.formatMessage({ id: `${localePrefix}.values.enabled` }),
                        disabledLabel: intl.formatMessage({ id: `${localePrefix}.values.disabled` }),
                        formatDate,
                      }),
                    },
                  ];
                });
              })()}
{{- else }}
              ]}
{{- end }}
            />
          </Space>
        ) : null}
      </Drawer>
{{- end }}
    </PageContainer>
  );
}
