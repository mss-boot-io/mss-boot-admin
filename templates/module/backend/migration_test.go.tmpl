		}
		original := fmt.Sprintf("%q %s", column.name, declaredType)
		replacement := fmt.Sprintf("%q BLOB", column.name)
		if drifted := strings.Replace(ddl, original, replacement, 1); drifted != ddl {
			return drifted, true
		}
