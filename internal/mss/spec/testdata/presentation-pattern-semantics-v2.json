{
  "accepted": [
    {
      "pattern": "^[A-Z0-9_-]+$",
      "matches": ["SUPPLIER_01"],
      "rejects": ["SUPPLIER_01\n"]
    },
    {
      "pattern": "^[^A]$",
      "matches": ["😀"],
      "rejects": ["A"]
    },
    {
      "pattern": "^[^\\n]$",
      "matches": ["😀", "\r", "\u2028"],
      "rejects": ["\n"]
    },
    {
      "pattern": "^[\\t\\n\\f\\r ]$",
      "matches": ["\t", "\n", "\f", "\r", " "],
      "rejects": ["\u00a0"]
    },
    {
      "pattern": "^[\\-]$",
      "matches": ["-"],
      "rejects": ["_"]
    },
    {
      "pattern": "^(\\{|\\}|\\])$",
      "matches": ["{", "}", "]"],
      "rejects": ["["]
    }
  ],
  "rejected": [
    "^.$",
    "^\\s$",
    "^\\S$",
    "^\\u0041$",
    "^\\cA$",
    "^[\\b]$",
    "^a{1001}$",
    "^[]a]$",
    "^[]$",
    "^[^]$",
    "^a{$",
    "^a}$",
    "^a]$",
    "^\\-$",
    "^\\_$",
    "^\\#$"
  ]
}
