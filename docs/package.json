{
  "name": "mss-boot-docs",
  "version": "0.0.0-development",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0 <25",
    "pnpm": "9.15.9"
  },
  "description": "Documentation site for the mss-boot Complete Admin Distribution, Thin Host architecture, agent workflows, operations, and releases.",
  "homepage": "https://docs.mss-boot-io.top",
  "repository": {
    "type": "git",
    "url": "https://github.com/mss-boot-io/mss-boot-admin.git",
    "directory": "docs"
  },
  "bugs": {
    "url": "https://github.com/mss-boot-io/mss-boot-admin/issues"
  },
  "scripts": {
    "audit:release": "node ../tools/security/check-pnpm-audit.mjs",
    "start": "dumi dev",
    "dev": "dumi dev",
    "build": "dumi build && python3 ../tools/release/prepare_portable_frontend.py dist --markdown-root docs",
    "prepare": "husky install && dumi setup"
  },
  "authors": [
    "lwnmengjing@gmail.com"
  ],
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ]
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@babel/runtime": "7.29.7",
      "@vitejs/plugin-react@4.0.0": "4.7.0",
      "esbuild": "0.28.1",
      "@hono/node-server": "2.0.10",
      "body-parser@1.20.5": "1.20.6",
      "brace-expansion@1.1.15": "1.1.18",
      "brace-expansion@2.1.1": "2.1.4",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "immutable@4.3.8": "4.3.9",
      "immutable@5.1.6": "5.1.8",
      "js-yaml": "4.3.1",
      "nanoid@3.3.12": "3.3.18",
      "nth-check": "2.1.1",
      "path-to-regexp": "1.9.0",
      "piscina": "4.9.3",
      "postcss": "8.5.23",
      "react-router@6.3.0": "6.30.4",
      "react-router-dom@6.3.0": "6.30.4",
      "send": "0.19.2",
      "svgo@2.8.2": "2.8.3",
      "uuid": "11.1.1",
      "vite@4.5.2": "6.4.3"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "dumi": "^2.4.48",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
